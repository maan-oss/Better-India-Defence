# Strata configuration. Copy to .env and adjust. Every value is optional in development.
# In production (NODE_ENV=production) the server refuses to start with development secrets.

NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info

# --- Storage ------------------------------------------------------------------------------------------
# Unset: embedded PostgreSQL (PGlite) under DATA_DIR — zero setup, fully offline.
# Set: external PostgreSQL 16 (PostGIS optional; spatial indexes are added when the extension exists).
# DATABASE_URL=postgres://strata:strata@127.0.0.1:5432/strata
DATA_DIR=data
# 32 bytes hex. When set, media/object storage is encrypted at rest with AES-256-GCM.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# STORAGE_ENCRYPTION_KEY=

# --- Security -----------------------------------------------------------------------------------------
# Shared secret that sensor adapters / the simulator present to /api/ingest (min 16 chars).
STRATA_SERVICE_TOKEN=dev-service-token-change-me
SESSION_TTL_HOURS=12
# Demo accounts viewer / operator / analyst / admin (development only).
STRATA_DEMO_USERS=true
STRATA_DEMO_PASSWORD=strata-demo
# Required in production: initial administrator password (min 12 chars).
# STRATA_ADMIN_PASSWORD=
# TLS directly on the API process:
# TLS_CERT_FILE=/etc/strata/tls/cert.pem
# TLS_KEY_FILE=/etc/strata/tls/key.pem
# Set true when TLS is terminated by a reverse proxy (adds Secure to the session cookie).
COOKIE_SECURE=false

# --- Simulator (synthetic data source for the test facility) ------------------------------------------
SIM_URL=http://127.0.0.1:4100
SIM_PORT=4100
SIM_STATE_FILE=data/sim-state.json
# Minutes of recorded history produced on first run.
SEED_MINUTES=120
# npm start only: set false to run without the simulator (e.g. real adapters posting to /api/ingest).
STRATA_SIMULATOR=true

# --- Vision, cameras, evidence ------------------------------------------------------------------------
# Directory holding the vision model files (npm run models:fetch). Default: ./models next to the manifest.
# The manifest with pinned SHA-256 hashes always comes from the code; this directory only supplies files.
# STRATA_MODELS_DIR=
# Directory from which recorded video files may be played as cameras (file:// sources are confined to it).
# Default: <DATA_DIR>/import
# STRATA_IMPORT_DIR=

# --- Field adapters (packages/adapters: strata-adapter <config.json>) ----------------------------------
# The adapter reads STRATA_INGEST_URL and STRATA_SERVICE_TOKEN. See docs/INTEROP.md.
# STRATA_INGEST_URL=http://127.0.0.1:4000

# --- Copilot ------------------------------------------------------------------------------------------
# auto: deterministic engine, plus language routing through the Anthropic API when a key is present.
# The model never produces facts; every answer is computed from the database with evidence references.
COPILOT_PROVIDER=auto
# ANTHROPIC_API_KEY=
COPILOT_MODEL=claude-opus-5-5

# Open an incident automatically for critical/high alerts.
AUTO_INCIDENTS=true
# Production only: path to the built web client (npm start sets this).
# WEB_DIST=apps/web/dist
