{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://strata.local/schemas/reorder-request.schema.json",
  "title": "reorder-request",
  "type": "object",
  "properties": {
    "quantity": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1000000000
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    }
  },
  "required": [
    "quantity",
    "reason"
  ]
}
