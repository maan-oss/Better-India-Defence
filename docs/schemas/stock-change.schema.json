{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://strata.local/schemas/stock-change.schema.json",
  "title": "stock-change",
  "type": "object",
  "properties": {
    "change": {
      "type": "number",
      "minimum": -1000000000,
      "maximum": 1000000000
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  },
  "required": [
    "change",
    "reason"
  ]
}
